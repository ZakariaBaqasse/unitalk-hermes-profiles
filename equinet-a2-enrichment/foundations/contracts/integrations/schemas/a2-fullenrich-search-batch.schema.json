{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "a2-fullenrich-search-batch-0.1.0",
  "required": [
    "run_id",
    "requests"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "request_id",
          "company_id",
          "target_titles",
          "limit"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "company_id": {
            "type": "string"
          },
          "company_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": "object"
          },
          "target_titles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          }
        },
        "additionalProperties": true
      }
    }
  }
}
