    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "request_id",
          "company_id",
          "target_titles",
          "limit",
          "search_stage",
          "target_priority"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "company_id": {
            "type": "string"
          },
          "company_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": "object"
          },
          "target_titles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "search_stage": {
            "enum": [
              "primary",
              "owner",
              "secondary"
            ]
          },
          "target_priority": {
            "enum": [
              "PRIMARY",
              "SECONDARY"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "search_stage": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "primary",
        "owner",
        "secondary",
        null
      ]
    }
  }
}
