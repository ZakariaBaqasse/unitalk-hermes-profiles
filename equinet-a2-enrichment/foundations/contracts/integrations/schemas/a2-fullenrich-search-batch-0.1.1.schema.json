{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "a2-fullenrich-search-batch-0.1.1",
  "required": [
    "run_id",
    "requests"
  ],
  "properties": {
    "run_id": {
      "type": "string"
