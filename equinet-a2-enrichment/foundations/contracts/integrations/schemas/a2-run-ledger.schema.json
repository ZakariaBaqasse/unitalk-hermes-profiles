{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "a2-run-ledger-0.1.0",
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "stage",
    "company_ids",
    "artifacts",
    "ledger_sha256"
  ],
  "properties": {
    "schema_id": {
      "const": "a2-enrichment-run-ledger"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "created",
        "pulled",
        "claimed",
        "lookup_complete",
        "lookup_decisions_validated",
        "search_complete",
        "selection_decisions_validated",
        "contact_enrichment_complete",
        "write_plan_validated",
        "twenty_written",
        "reconciled",
        "terminal"
      ]
    },
    "company_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array"
    },
    "ledger_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
