{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a2-official-site-observations-0.1.0",
  "type": "object",
  "required": [
    "schema_id",
    "run_id",
    "company_id",
    "status",
    "source_pages",
    "contacts",
    "social_links",
    "candidate_people",
    "person_evidence_blocks",
    "person_extraction_coverage"
  ],
  "properties": {
    "schema_id": {
      "const": "a2-official-site-observations"
    },
    "status": {
      "const": "observed"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "contact_type",
          "observed_value",
          "page_evidence"
        ]
      }
    },
    "social_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "platform",
          "observed_url",
          "page_evidence"
        ]
      }
    },
    "candidate_people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "observed_name",
          "page_evidence"
        ],
        "properties": {
          "observed_role": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "business_decisions_made": {
      "const": false
    },
    "person_evidence_blocks": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "block_id",
          "page_index",
          "page_url",
          "page_content_sha256",
          "source_index",
          "text",
          "untrusted_source_content"
        ],
        "properties": {
          "block_id": {
            "type": "string"
          },
          "page_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "page_url": {
            "type": "string",
            "format": "uri"
          },
          "page_content_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_index": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          },
          "untrusted_source_content": {
            "const": true
          }
        },
        "additionalProperties": true
      }
    },
    "person_extraction_coverage": {
      "type": "object",
      "required": [
        "status",
        "semantic_block_count",
        "deterministic_candidate_count",
        "llm_observation_proposals_validated"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending_llm_observation_proposals",
            "complete_no_relevant_blocks",
            "complete"
          ]
        },
        "semantic_block_count": {
          "type": "integer",
          "minimum": 0
        },
        "deterministic_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "llm_observation_proposals_validated": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
