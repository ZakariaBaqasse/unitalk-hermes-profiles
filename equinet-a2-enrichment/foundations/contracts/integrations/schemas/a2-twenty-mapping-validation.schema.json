{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "a2-twenty-mapping-validation-0.1.0",
  "required": [
    "status",
    "mapping_version",
    "observed",
    "metadata_sha256",
    "errors"
  ],
  "properties": {
    "status": {
      "enum": [
        "valid",
        "invalid"
      ]
    },
    "mapping_version": {
      "type": "string"
    },
    "observed": {
      "type": "object"
    },
    "metadata_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "errors": {
      "type": "array"
    }
  }
}
