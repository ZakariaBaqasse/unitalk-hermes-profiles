{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "a2-company-batch-0.1.0",
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "company_count",
    "companies",
    "artifact_sha256"
  ],
  "properties": {
    "schema_id": {
      "const": "a2-twenty-company-batch"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "company_count": {
      "type": "integer",
      "minimum": 0
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "twenty_company_id",
          "name",
          "segment",
          "linked_people"
        ],
        "properties": {
          "twenty_company_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "segment": {
            "enum": [
              "FARRIER",
              "HORSE_OWNER",
              "farrier",
              "horse_owner"
            ]
          },
          "domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "linked_people": {
            "type": "array"
          }
        }
      }
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
