    "official_website_vs_fullenrich_current_role": "material_conflict_hold"
  },
  "email_specific_rules": {
    "officially_published_professional_email": "may_be_verified_from_one_exact_official_source",
    "apify_email_search": "requires_exact_identity_and_company_match_plus_provider_verification",
    "personal_email": "not_requested_by_default_but_retained_if_incidentally_returned_with_provider_provenance_verification_status_and_human_review",
    "deliverability_does_not_create_consent": true,
    "email_source_must_not_be_mislabeled_as_linkedin": true,
    "fullenrich_work_email": "requires_exact_identity_and_company_match_plus_non_invalid_provider_status"
  },
  "outcomes": {
    "required_field_unsatisfied": {
      "field_quality": "gap",
      "record_quality": "incomplete",
      "automatic_rejection": false,
      "workflow_after_research_exhausted": "review_required",
      "human_dispositions": [
        "needs_changes",
        "held",
        "approved_collect_during_discovery",
        "rejected_for_explicit_business_reason"
      ]
    },
    "optional_field_unsatisfied": {
      "field_quality": "gap",
