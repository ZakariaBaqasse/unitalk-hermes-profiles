    "horse_count_range_is_ignored": true,
    "horse_count_band_new_values_prohibited": true,
    "missing_required_business_data_still_reaches_final_human_review": true,
    "fullenrich_search_and_lookup_do_not_supply_contact_channels": true,
    "fullenrich_personal_email_is_not_requested": true,
    "fullenrich_mobile_is_stored_separately_from_business_phone": true,
    "fullenrich_incidental_personal_email_is_retained_separately": true
  },
