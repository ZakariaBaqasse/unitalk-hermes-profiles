      "sha256": "008e6f8ffca793f4fe2d9a4cb83d90f9318c7f392d88a64960084a1fd739d527"
    },
    {
      "path": "foundations/contracts/governance/a2-provider-and-cost-policy-0.3.0.json",
      "sha256": "7adf957a3161e1d45a47149167bc66e4387a877908a2ba2ca4e232d01d2c5a09"
    },
    {
      "path": "foundations/contracts/business/a2-business-field-catalogue-0.3.0.json",
      "sha256": "8e1995048ce786843cf7419191b72a6d597acb1f1b5afa546454810c6c8ffc3d"
    },
