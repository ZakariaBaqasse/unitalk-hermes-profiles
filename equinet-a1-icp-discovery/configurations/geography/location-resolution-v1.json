{
  "policy_id": "equinet-a1-location-resolution",
  "version": "1.0.0",
  "status": "approved_for_production",
  "effective_at": "2026-09-03",
  "approved_country_codes": ["US", "AU", "NZ"],
  "required_user_fields": ["country", "region", "city"],
  "rules": {
    "defaults_allowed": false,
    "infer_country_from_city": false,
    "infer_region_from_city": false,
    "complete_unambiguous_input_requires_additional_confirmation": false,
    "missing_or_ambiguous_interactive_action": "ask_user_before_launch",
    "unattended_missing_or_ambiguous_action": "reject_before_launch",
    "supplied_name_code_conflict_action": "ask_user_before_launch",
    "location_key_format": "COUNTRY_CODE|REGION_CODE|city-slug"
  },
  "countries": {
