#!/usr/bin/env python3
"""Print non-secret structure and relevant hardening clauses from profile policy files."""
from pathlib import Path
import json
try:
    import yaml
except Exception as exc:
    print(json.dumps({"error":f"yaml_import:{type(exc).__name__}"})); raise SystemExit(1)
root=Path(__file__).resolve().parents[3]
out={}
for rel in ["configurations/operations/a1-runtime-policy-v1.yaml","configurations/evidence/public-website-enrichment-policy-v1.yaml"]:
    p=root/rel
    try:
        data=yaml.safe_load(p.read_text(encoding="utf-8"))
        out[rel]={"top_level_keys":list(data) if isinstance(data,dict) else [],"version_values":{k:v for k,v in (data.items() if isinstance(data,dict) else []) if "version" in str(k).lower()},"hardening":data.get("enrichment_state_hardening") if isinstance(data,dict) else None}
    except Exception as exc:
        out[rel]={"error":f"{type(exc).__name__}:{exc}"}
soul=root/"SOUL.md"
text=soul.read_text(encoding="utf-8") if soul.exists() else ""
out["SOUL.md"]={"exists":soul.exists(),"has_v2_hardening":"Enrichment State V2 Hardening" in text,"chars":len(text)}
print(json.dumps(out,indent=2,default=str))
