{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a1.twenty-company-overlays.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "source_sha256", "overlays"],
  "properties": {
    "schema_version": {"const": "a1.twenty-company-overlays.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "overlays": {"type": "array", "items": {"$ref": "#/$defs/overlay"}}
  },
  "$defs": {
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "lead_fingerprint", "website_status", "enrichment_status",
        "official_website_url", "qualification_status", "icp_score_status", "icp_score",
        "icp_band", "icp_outcome", "evidence_confidence_score",
        "evidence_confidence_level", "notes"
      ],
      "properties": {
        "schema_version": {"const": "a1.twenty-company-overlay.v2"},
        "lead_fingerprint": {"type": "string", "minLength": 1},
        "website_status": {"enum": ["verified", "none_found", "unverified", "blocked", "error"]},
        "enrichment_status": {"enum": ["not_required_no_website", "completed", "failed", "blocked"]},
        "official_website_url": {"type": ["string", "null"]},
        "qualification_status": {"enum": ["ELIGIBLE", "EXCLUDED", "NEEDS_REVIEW", "NOT_CHECKED"]},
        "icp_score_status": {"enum": ["NOT_SCORED", "SCORED", "BLOCKED"]},
        "icp_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "icp_band": {"type": ["string", "null"]},
        "icp_outcome": {"type": ["string", "null"]},
        "evidence_confidence_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "evidence_confidence_level": {"type": ["string", "null"]},
        "notes": {"type": "object"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "website_status": {"const": "verified"},
              "icp_score_status": {"const": "NOT_SCORED"}
            },
            "required": ["website_status", "icp_score_status"]
          },
          "then": {
            "properties": {
              "enrichment_status": {"const": "failed"},
              "official_website_url": {"type": "string", "pattern": "^https?://"},
              "notes": {
                "type": "object",
                "required": ["outcome_provenance"],
                "properties": {
                  "outcome_provenance": {
                    "type": "object",
                    "required": ["outcome", "failure_code", "retries_exhausted"],
                    "properties": {
                      "outcome": {"const": "assessment_failed"},
                      "failure_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
                      "retries_exhausted": {"const": true}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
