{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitalk.ai/schemas/equinet/a1/twenty-entity-staging-index/2.0.0",
  "title": "Equinet A1 Twenty Company and Person Staging Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "input_sha256", "website_overlay_provenance", "complete", "total", "counts", "dispositions"],
  "properties": {
    "schema_version": {"const": "a1.twenty-entity-staging-index.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "website_overlay_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_sha256", "overlay_count", "verified_unscored_count", "explicit_exhausted_assessment_failure_count", "unexplained_verified_unscored_count"],
      "properties": {
        "schema_version": {"const": "a1.website-overlay-provenance.v1"},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "overlay_count": {"type": "integer", "minimum": 0},
        "verified_unscored_count": {"type": "integer", "minimum": 0},
        "explicit_exhausted_assessment_failure_count": {"type": "integer", "minimum": 0},
        "unexplained_verified_unscored_count": {"const": 0}
      }
    },
    "complete": {"const": true},
    "total": {"type": "integer", "minimum": 1},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "dispositions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/disposition"}}
  },
  "$defs": {
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lead_fingerprint", "status", "company_id", "person_required", "person_id", "company_disposition", "person_disposition", "relation_status", "operation", "company_operation", "person_operation", "reason", "duplicate_preflight_completed", "person_duplicate_preflight_completed", "write_attempted", "write_outcome_uncertain", "company_reconciliation_artifact", "person_reconciliation_artifact", "relation_reconciliation_artifact", "artifact_reference"],
      "properties": {
        "lead_fingerprint": {"type": "string", "minLength": 1},
        "status": {"enum": ["company_staged_person_staged", "company_staged_no_person_required", "company_staged_person_possible_match", "company_staged_person_sync_failed", "company_possible_match", "company_sync_failed", "blocked_missing_company_name"]},
        "company_id": {"type": ["string", "null"]},
        "person_required": {"type": "boolean"},
        "person_id": {"type": ["string", "null"]},
        "company_disposition": {"type": "string", "minLength": 1},
        "person_disposition": {"enum": ["staged", "not_required", "possible_match", "sync_failed", "blocked_by_company"]},
        "relation_status": {"enum": ["verified", "not_required", "unverified"]},
        "operation": {"enum": ["create", "update", null]},
        "company_operation": {"enum": ["create", "update", null]},
        "person_operation": {"enum": ["create", "update", null]},
        "reason": {"type": "string", "minLength": 1},
        "duplicate_preflight_completed": {"type": "boolean"},
        "person_duplicate_preflight_completed": {"type": "boolean"},
        "write_attempted": {"type": "boolean"},
        "write_outcome_uncertain": {"type": "boolean"},
        "company_reconciliation_artifact": {"type": ["string", "null"]},
        "person_reconciliation_artifact": {"type": ["string", "null"]},
        "relation_reconciliation_artifact": {"type": ["string", "null"]},
        "artifact_reference": {"type": ["string", "null"]}
      }
    }
  }
}
