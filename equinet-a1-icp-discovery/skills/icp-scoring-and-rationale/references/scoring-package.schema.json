{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitalk.ai/schemas/equinet/a1/scoring-package/1.0.0",
  "title": "Equinet A1 Scoring and Rationale Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["scoring", "audit", "explanation", "confidence_context"],
  "properties": {
    "scoring": {"type": "object"},
    "audit": {"type": "object"},
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "confirmed_criteria", "unearned_weighted_criteria", "applied_band_rules", "outcome", "review_required", "confidence_interpretation"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 3000},
        "confirmed_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion_id", "points", "evidence_ids"],
            "properties": {
              "criterion_id": {"type": "string", "minLength": 1},
              "points": {"type": "integer", "minimum": 1, "maximum": 100},
              "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            }
          }
        },
        "unearned_weighted_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "applied_band_rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "outcome": {"type": "string", "minLength": 1},
        "review_required": {"type": "boolean"},
        "confidence_interpretation": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "confidence_context": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "score", "method_version"],
          "properties": {
            "level": {"type": "string", "enum": ["high", "medium", "low"]},
            "score": {"type": "number", "minimum": 0, "maximum": 100},
            "method_version": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
